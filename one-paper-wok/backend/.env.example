# 本地开发可复制为 .env。Railway 请在服务 Variables 里填写，不要提交真实密钥。

JWT_SECRET=replace-with-a-long-random-string

# 可选：真实 OCR / 大模型 / 发信。不填则全部走 Mock。
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# DASHSCOPE_API_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# OCR_PROVIDER=auto
# LLM_PROVIDER=auto
# EMAIL_PROVIDER=auto

# Railway Volume 挂载到 /data 后会自动覆盖下面两项；本地一般不用改。
# DATA_DIR=data
# DATABASE_URL=sqlite:///./data/app.db
